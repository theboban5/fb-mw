# Copy to .env (which is gitignored) and fill in. NEVER commit .env.
#
# ── Building from the spreadsheet (the original source; still the default) ───
# No secrets are needed: the spreadsheet (13 league tabs + seven nt_*
# national-team tabs) is published to the web and its URLs live in
# src/dataset.py.
#
# Optional overrides (set as plain environment variables):
#   DATASET_LOCAL_DIR=data/canonical   # build offline from local {tab}.csv files
#   DATASET_BASE_URL=https://...       # alternate published-spreadsheet base URL

# ── Building from Supabase ──────────────────────────────────────────────────
# DATASET_SOURCE picks where the build reads its data:
#   sheets    (default) the published Google Spreadsheet
#   supabase  the Postgres tables, rebuilt into the identical CSV text
# DATASET_LOCAL_DIR outranks both, so the offline build still works either way.
DATASET_SOURCE=sheets

SUPABASE_URL=https://your-project-ref.supabase.co

# Safe to expose in a browser: it is subject to Row Level Security, and every
# table's public policy grants SELECT only. This is the key /report ships with.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ⚠ SERVER-SIDE ONLY. Bypasses Row Level Security entirely — it can read and
# write every row in the database. Use it from local admin scripts and CI only.
# It must NEVER appear in static/, in any browser JavaScript, or in a commit.
# The site build needs it because `reporters` holds emails and so has no public
# read policy; a read-only local build can use the publishable key instead.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ⚠ SERVER-SIDE ONLY. The direct Postgres connection, used exclusively to apply
# migrations (`npx supabase db push --db-url "$SUPABASE_DB_URL"`). Percent-encode
# any special characters in the password.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
