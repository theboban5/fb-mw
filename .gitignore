.env
__pycache__/
*.pyc
.DS_Store
# Local dev fixtures (copies of data/canonical/ with fake rows) and parity
# builds. Fake data must never land in data/canonical/.
data/scratch/
staging/
staging-*/

# Generated post packs. Every run can be rebuilt from the sheet, and the PNGs
# are large — nothing here belongs in git.
out/

# Supabase CLI scratch. `cli-latest` is a version cache and
# `linked-project.json` records which project THIS machine is linked to —
# both are local state that npx rewrites on every run, so they showed up as
# spurious modifications in every diff after a db push.
supabase/.temp/

# Handoff notes between sessions. Working scratch, not repo content.
NEXT_SESSION.md
